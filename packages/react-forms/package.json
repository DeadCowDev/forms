	"license": "MIT",
	"version": "0.5.0",
	"private": false,
	"description": "Agnostic model-driven simple and typesafe approach to forms in react.",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"repository": "https://github.com/DeadCowDev/forms",
