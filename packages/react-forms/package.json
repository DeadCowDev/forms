		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.1",
		"react-dom": "^19.2.0",
		"react": "^19.2.0"
	},
	"dependencies": {
		"@deadcow-enterprises/forms-core": "workspace:*"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.2.0",
		"zod": "^4.1.12"
	}
